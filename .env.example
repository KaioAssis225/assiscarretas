# Copie para .env e ajuste. NUNCA commite o .env real.

# --- Banco (Docker Compose de desenvolvimento) ---
POSTGRES_USER=assiscarretas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=assiscarretas

# --- Backend ---
ASSISCARRETAS_ENVIRONMENT=local
ASSISCARRETAS_DEBUG=true
ASSISCARRETAS_CORS_ORIGINS=http://localhost:5173
# 127.0.0.1 (não localhost): evita travamento IPv6 com o proxy do Docker no Windows
DATABASE_URL=postgresql+psycopg://assiscarretas:troque-esta-senha@127.0.0.1:5432/assiscarretas

# --- Frontend ---
# Opcional em dev (default http://localhost:8000). Em produção NÃO defina:
# o build usa o mesmo domínio via proxy do Vercel.
VITE_API_URL=http://localhost:8000

# --- Produção (Railway) — exemplos de NOMES; valores reais só no painel ---
# ASSISCARRETAS_ENVIRONMENT=production
# ASSISCARRETAS_SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ASSISCARRETAS_CORS_ORIGINS=https://seu-app.vercel.app
# DATABASE_URL=(injetada pelo Postgres do Railway)
